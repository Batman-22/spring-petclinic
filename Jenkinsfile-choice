pipeline {
    agent {label 'JDK8'}
    parameters {
        choice(name: 'Goal', choices: ['package', 'clean package'], description: 'Build with a paramter')
    }
    stages{
        stage('clone'){
            steps{
            sh 'git checkout test'
        }
        }
        stage('build'){
            steps{
            sh "mvn ${params.Goal}"
        }
        }
    }
}