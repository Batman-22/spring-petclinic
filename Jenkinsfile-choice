pipeline {
    agent {label 'JDK8'}
    parameters {
        choice(name: 'Goal', choices: ['package', 'clean package'], description: 'Build with a paramter')
    }
    stages{
        stage('clone'){
            steps{
            git branch: 'test', url: 'https://github.com/Batman-22/spring-petclinic.git'
        }
        }
        stage('build'){
            steps{
            sh "mvn ${params.Goal}"
        }
        }
    }
}